# ===== LyricHud SPI display (generated by install.sh; do not edit) =====
# ST7789V 240x240 SPI via fbtft; vc4-kms-v3d disabled so X uses fbdev
dtparam=spi=on
dtoverlay=fbtft,spi0-0,st7789v,reset_pin=27,dc_pin=25,led_pin=24,speed=60000000,rotate=0,width=240,height=240,fps=60,init=-1,0x11,-2,120,-1,0x36,0x00,-1,0x3A,0x05,-1,0xB2,0x0C,0x0C,0x00,0x33,0x33,-1,0xB7,0x35,-1,0xBB,0x37,-1,0xC0,0x2C,-1,0xC2,0x01,-1,0xC3,0x12,-1,0xC4,0x20,-1,0xC6,0x0F,-1,0xD0,0xA4,0xA1,-1,0xE0,0xD0,0x04,0x0D,0x11,0x13,0x2B,0x3F,0x54,0x4C,0x18,0x0D,0x0B,0x1F,0x23,-1,0xE1,0xD0,0x04,0x0C,0x11,0x13,0x2C,0x3F,0x44,0x51,0x2F,0x1F,0x1F,0x20,0x23,-1,0x21,-1,0x29,-3
max_framebuffers=2
disable_fw_kms_setup=1
arm_boost=1
gpio=6,19,5,26,13,21,20,16=pu
framebuffer_width=240
framebuffer_height=240
hdmi_force_hotplug=1
hdmi_cvt=240 240 60 1 0 0 0
hdmi_dpi=240 240
hdmi_group=2
#hdmi_mode=1
hdmi_mode=87
hdmi_ignore_edid=0xa5000080
#hdmi_timings=240 2 34 34 0 240 2 18 18 0 0 0 60 0 6250000 3
display_rotate=0
disable_overscan=1
#overscan_left=80
#overscan_right=10
#overscan_top=10
#overscan_bottom=10
display_auto_detect=0
# ===== LyricHud end =====
